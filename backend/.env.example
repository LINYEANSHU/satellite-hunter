# Satellite Hunter backend configuration example.
# Copy to backend/.env (or export as environment variables) — every key is optional.
# All variables use the SH_ prefix; see backend/app/core/config.py.
#
# NOTE: this project stores no API keys or passwords. CelesTrak GP/TLE is a free
# public feed and no token is required; the SQLite database has no password.

# ---- Server ----
#SH_HOST=127.0.0.1
#SH_PORT=8000
#SH_LOG_LEVEL=INFO

# ---- Runtime data root (databases, orbit cache, recordings, outputs) ----
#SH_DATA_DIR=./data

# ---- Orbit data ----
# CelesTrak GP endpoint (free, no API key needed)
#SH_CELESTRAK_BASE=https://celestrak.org/NORAD/elements/gp.php
# Minimum hours between refetches of the same group
#SH_ORBIT_CACHE_TTL_HOURS=2
# Default minimum elevation (degrees) for pass prediction
#SH_DEFAULT_MIN_ELEVATION_DEG=0
# Comma-separated CelesTrak groups used by the catalog
#SH_ORBIT_GROUPS=stations,weather,amateur,science,visual,geo,active

# ---- SatDump (optional external decoder) ----
# Executable name or full path; "satdump" expects it on PATH
#SH_SATDUMP_BIN=satdump
# WSL distro used when SatDump is only available under WSL
#SH_WSL_DISTRO=Ubuntu-24.04
# Hard timeout for a single decode job (seconds)
#SH_SATDUMP_TIMEOUT_S=3600

# ---- CORS (frontend origins allowed in single-port/dev setups) ----
#SH_CORS_ORIGINS=["http://localhost:5273","http://127.0.0.1:5273"]
